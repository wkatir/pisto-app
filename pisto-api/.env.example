DB_SERVER=localhost
DB_PORT=1433
DB_NAME=pisto_app
DB_USER=your_sql_server_user
DB_PASSWORD=YourPassword123!
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true

# Generate strong secrets (>=32 chars). Example:
#   bun -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace_with_strong_secret_at_least_32_chars
JWT_REFRESH_SECRET=replace_with_strong_secret_at_least_32_chars

PORT=3000
NODE_ENV=development

# Comma-separated whitelist. Wildcard "*" allowed only in development.
# Production must list explicit origins, e.g. https://app.pistoapp.com,https://admin.pistoapp.com
CORS_ORIGIN=http://localhost:3000,http://localhost:8080

# Rate limiting on by default. Set to "false" only for local debugging.
RATE_LIMIT_ENABLED=true

# Set to "true" only when behind a trusted reverse proxy (e.g. Cloudflare, nginx).
# When true, the rate limiter trusts X-Forwarded-For for client IP detection.
TRUST_PROXY=false

# Optional: bootstrap admin credentials for the seed script.
# If not set, the seed will generate a random password and print it to stdout.
# ADMIN_EMAIL=admin@pistoapp.com
# ADMIN_PASSWORD=
